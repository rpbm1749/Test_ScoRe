# Copy this file to .env and paste your keys. .env is git-ignored, never commit it.
# NVIDIA (default for both models): free key from build.nvidia.com, no payment details needed.
NVIDIA_API_KEY=nvapi-your_key_here
# Optional alternatives, only needed if you switch a model's provider in config.yaml:
GROQ_API_KEY=
CEREBRAS_API_KEY=
